# An empty file fails preview and execution before an encode.
# The stub replays HandBrake's scan exit 2 for this input.
# spec: no-video-title
chmod 755 bin/HandBrakeCLI
env NCLY_NO_INPUT=1
env NCLY_JSON=1
env QA_INPUT=empty.mov
exec sh -c ': > empty.mov'
cp empty.mov empty.mov.before
exits 2 ncly video convert empty.mov --force --dry-run
stderr '"code":"VIDEO_CONVERT_UNREADABLE"'
stderr '"message":"[^"]*empty\.mov'
stderr '"hint":"[^"]*empty\.mov'
! stdout .
exec sh bin/assert-invariants
exits 2 ncly video convert empty.mov --force
stderr '"code":"VIDEO_CONVERT_UNREADABLE"'
stderr '"message":"[^"]*empty\.mov'
stderr '"hint":"[^"]*empty\.mov'
! stdout .
exec sh bin/assert-invariants

-- empty.mov --

-- empty.mov.before --

-- empty.converted.mp4 --
previous
-- previous.mp4 --
previous
-- bin/HandBrakeCLI --
#!/bin/sh
set -eu
printf '%s\n' "$$" >> "$WORK/stub.pids"
for arg in "$@"; do
  if [ "$arg" = --version ]; then
    echo 'HandBrake 1.11.2'
    exit 0
  fi
  if [ "$arg" = --scan ]; then
    echo 'No title found.' >&2
    exit 2
  fi
done
echo 'unexpected call after the failed scan' >&2
exit 9
-- bin/assert-invariants --
#!/bin/sh
set -eu
cmp "$QA_INPUT" "$QA_INPUT.before"
cmp "${QA_INPUT%.*}.converted.mp4" previous.mp4
for p in .ncly-video-convert-*; do
  test ! -e "$p" && test ! -L "$p" || exit 91
done
if [ -f stub.pids ]; then
  while read -r pid; do
    if kill -0 "$pid" 2>/dev/null; then
      echo "surviving stub PID $pid" >&2
      exit 92
    fi
  done < stub.pids
fi
