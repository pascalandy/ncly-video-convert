# The primary command-boundary tests cover publication, overwrite consent,
# dry-run safety, failed processes, and false success without an output.
chmod 755 bin/HandBrakeCLI
env NCLY_NO_INPUT=1
env NCLY_JSON=1

# Dry run checks prerequisites but creates no output or staging directory.
ncly video convert 'clips/one clip.mov' --dry-run
stdout '"dry_run":true'
stdout '"output":".*one clip.converted.mp4"'
stdout '"codec":"h264"'
stdout '"encoder":"x264"'
stdout '"normalize":false'
! exists 'clips/one clip.converted.mp4'
! exists encoded.log

# A file in which HandBrake finds no video fails both modes before any encode,
# and its message and hint name the file, since a repeat cannot fix it.
exits 2 ncly video convert faux.mp4 --dry-run
stderr '"code":"VIDEO_CONVERT_UNREADABLE"'
stderr '"message":"[^"]*faux\.mp4'
stderr '"hint":"[^"]*faux\.mp4'
exits 2 ncly video convert faux.mp4
stderr '"code":"VIDEO_CONVERT_UNREADABLE"'
stderr '"message":"[^"]*faux\.mp4'
stderr '"hint":"[^"]*faux\.mp4'
! exists encoded.log
! exists faux.converted.mp4
exec sh -c 'for p in .ncly-video-convert-*; do test ! -e "$p" || exit 1; done'

# Only exit 2 of the scan maps to VIDEO_CONVERT_UNREADABLE. Another failed
# scan stays RUNTIME, and so does a scan without a title set, or whose first
# title has no duration, which tells a video from a still image.
env STUB=scanfail
exits 1 ncly video convert 'clips/one clip.mov'
stderr '"code":"RUNTIME"'
! exists encoded.log
! exists 'clips/one clip.converted.mp4'
env STUB=notitles
exits 1 ncly video convert 'clips/one clip.mov' --dry-run
stderr '"code":"RUNTIME"'
! exists encoded.log
env STUB=noduration
exits 1 ncly video convert 'clips/one clip.mov' --dry-run
stderr '"code":"RUNTIME"'
exits 1 ncly video convert 'clips/one clip.mov'
stderr '"code":"RUNTIME"'
! exists encoded.log
! exists 'clips/one clip.converted.mp4'
env STUB=

# A successful process must create a nonempty output. Both transport paths work.
ncly video convert 'clips/one clip.mov'
stdout '"size_bytes":8'
stdout '"codec":"h264"'
stdout '"encoder":"x264"'
stdout '"normalized":false'
cmp 'clips/one clip.converted.mp4' expected.mp4
cmp 'clips/one clip.mov' original.mov
exits 2 ncly video convert 'clips/one clip.mov'
stderr '"code":"CONFIRMATION_REQUIRED"'
cmp 'clips/one clip.converted.mp4' expected.mp4
ncly-video-convert 'clips/one clip.mov' --force
stdout '"size_bytes":8'

# Failure after writing partial data preserves the previous complete output.
# An encode that exits 2 stays RUNTIME, unlike a scan that exits 2.
env STUB=fail
exits 1 ncly video convert 'clips/one clip.mov' --force
stderr '"code":"RUNTIME"'
cmp 'clips/one clip.converted.mp4' expected.mp4
cmp 'clips/one clip.mov' original.mov

# An output arriving between preparation and publication must not be replaced.
env STUB=race
exits 2 ncly video convert race.mov
stderr '"code":"CONFIRMATION_REQUIRED"'
grep '^arrived$' race.converted.mp4

# HandBrake prints progress on stdout during the whole encode, so a long
# encode writes more than the SDK's default 1 MB and must still succeed.
env STUB=chatty
ncly video convert chatty.mov
stdout '"size_bytes":8'
cmp chatty.converted.mp4 expected.mp4

# A zero exit without a regular nonempty file is not success.
env STUB=missing
exits 1 ncly video convert missing.mov
stderr '"code":"RUNTIME"'
! exists missing.converted.mp4
env STUB=empty
exits 1 ncly video convert empty.mov
stderr '"code":"RUNTIME"'
! exists empty.converted.mp4

# Timeout cleans partial data and never publishes it.
env STUB=hang
exits 1 ncly video convert timeout.mov --timeout 100ms
stderr '"code":"RUNTIME"'
! exists timeout.converted.mp4
exec sh -c 'for p in .ncly-video-convert-* clips/.ncly-video-convert-*; do test ! -e "$p" || exit 1; done'

# The scan's time counts against --timeout, and the encode gets the rest, yet
# the message names the timeout that the user gave, not that rest.
env STUB=slowscan
exits 1 ncly video convert slow.mov --timeout 3s
stderr '"code":"RUNTIME"'
stderr '"message":"HandBrakeCLI did not finish within 3 s, so it was stopped\.'
! exists slow.converted.mp4
exec sh -c 'for p in .ncly-video-convert-*; do test ! -e "$p" || exit 1; done'

# Preparation runs under --timeout too, so a dry run whose scan and help
# outlast it fails as execution would, and names the given timeout.
env STUB=slowprep
exits 1 ncly video convert slow.mov --dry-run --timeout 1s
stderr '"code":"RUNTIME"'
stderr '"message":"HandBrakeCLI did not finish within 1 s, so it was stopped\.'

# Invalid input, timeout and unsafe output are rejected before encoding.
env STUB=
exits 2 ncly video convert absent.mov
stderr '"code":"USAGE_INVALID"'
exits 2 ncly video convert clips
stderr '"code":"USAGE_INVALID"'
exits 2 ncly video convert missing.mov --timeout soon
stderr '"code":"USAGE_INVALID"'
symlink linked.converted.mp4 -> linked.mov
exits 2 ncly video convert linked.mov --force
stderr '"code":"USAGE_INVALID"'
cmp linked.mov original.mov
exec ln hardlinked.mov hardlinked.converted.mp4
exits 2 ncly video convert hardlinked.mov --force
stderr '"code":"USAGE_INVALID"'
cmp hardlinked.mov original.mov
mkdir directory.converted.mp4
exits 2 ncly video convert directory.mov --force
stderr '"code":"USAGE_INVALID"'

# The file system resolves ".." after a symlink, so alias/../clip.mov names
# trap/actual/clip.mov, a link to trap/clip.converted.mp4. Cleaning ".." by
# text would pick trap/clip.mov, and --force would replace that linked file.
mkdir trap/actual/inner
symlink trap/alias -> actual/inner
symlink trap/actual/clip.mov -> ../clip.converted.mp4
ncly video convert trap/alias/../clip.mov --force
stdout '"input":".*/trap/actual/clip.mov"'
cmp trap/clip.converted.mp4 precious.mp4
cmp trap/actual/clip.converted.mp4 expected.mp4

# A folder that execution cannot write fails the dry run with the same code.
mkdir locked
cp original.mov locked/clip.mov
chmod 555 locked
exits 1 ncly video convert locked/clip.mov --dry-run
stderr '"code":"RUNTIME"'
exits 1 ncly video convert locked/clip.mov --force
stderr '"code":"RUNTIME"'
! exists locked/clip.converted.mp4
chmod 755 locked

# Cleanup reads the output's folder, so a folder that grants write and search
# but not read fails both modes before encoding, and keeps no staging.
mkdir dropbox
cp original.mov dropbox/clip.mov
chmod 333 dropbox
exits 1 ncly video convert dropbox/clip.mov --dry-run
stderr '"code":"RUNTIME"'
exits 1 ncly video convert dropbox/clip.mov
stderr '"code":"RUNTIME"'
chmod 755 dropbox
! exists dropbox/clip.converted.mp4
exec sh -c 'for p in dropbox/.ncly-video-convert-*; do test ! -e "$p" || exit 1; done'

# Missing HandBrake fails both execution and dry run with the prerequisite code.
mv bin/HandBrakeCLI bin/hidden-HandBrakeCLI
env PATH=$WORK/bin
exits 78 ncly video convert missing.mov --dry-run
stderr '"code":"PREREQ_MISSING"'
exits 78 ncly video convert missing.mov
stderr '"code":"PREREQ_MISSING"'

-- clips/one clip.mov --
original
-- original.mov --
original
-- race.mov --
original
-- chatty.mov --
original
-- missing.mov --
original
-- empty.mov --
original
-- timeout.mov --
original
-- slow.mov --
original
-- linked.mov --
original
-- directory.mov --
original
-- hardlinked.mov --
original
-- trap/clip.mov --
decoy
-- trap/clip.converted.mp4 --
precious
-- precious.mp4 --
precious
-- expected.mp4 --
encoded
-- faux.mp4 --
not a video
-- bin/HandBrakeCLI --
#!/bin/sh
# The help lists only CPU encoders, and the scan finds no audio, so these
# scenarios run neither a GPU encoder nor ffmpeg. encoders.txtar and
# loudness.txtar cover those.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help) if [ "$STUB" = slowprep ]; then sleep 0.6; fi; echo '   x264'; echo '   x265_10bit'; exit 0 ;;
    --input) input=$2; shift ;;
    --output) output=$2; shift ;;
    --preset) preset=$2; shift ;;
    --format) format=$2; shift ;;
    --scan) scan=1 ;;
  esac
  shift
done
if [ -n "$scan" ]; then
  if [ ! -f "$input" ] || [ -n "$preset" ]; then
    echo "unexpected scan: input=$input preset=$preset" >&2; exit 9
  fi
  if [ "$STUB" = scanfail ]; then echo 'scan failed' >&2; exit 3; fi
  if [ "$STUB" = slowscan ]; then sleep 1; fi
  if [ "$STUB" = slowprep ]; then sleep 0.6; fi
  if grep -qx 'not a video' "$input"; then echo 'No title found.' >&2; exit 2; fi
  if [ "$STUB" = notitles ]; then echo 'Version: {}'; exit 0; fi
  if [ "$STUB" = noduration ]; then echo 'JSON Title Set: {"TitleList":[{"AudioList":[]}]}'; exit 0; fi
  echo 'Version: {}'
  echo 'JSON Title Set: {"TitleList":[{"AudioList":[],"Duration":{"Ticks":360000},"FrameRate":{"Num":27000000,"Den":1080000}}]}'
  exit 0
fi
if [ ! -f "$input" ] || [ "$preset" != 'Fast 1080p30' ] || [ "$format" != av_mp4 ]; then
  echo "unexpected call: input=$input preset=$preset format=$format" >&2; exit 9
fi
echo invoked >> "$WORK/encoded.log"
case "$STUB" in
  fail) echo partial > "$output"; echo 'encoder failed' >&2; exit 2 ;;
  race) echo arrived > "$WORK/race.converted.mp4" ;;
  chatty) yes 'Encoding: task 1 of 1, 50.00 %' | head -c 1100000 ;;
  missing) exit 0 ;;
  empty) : > "$output"; exit 0 ;;
  hang|slowscan) echo partial > "$output"; exec sleep 30 ;;
esac
echo encoded > "$output"
