# Made media has a nondefault display rotation and private author metadata.
# ffprobe is independent of the adapter and of its wrapped programs.
exec ffmpeg -nostdin -v error -f lavfi -i testsrc2=size=160x96:rate=30 -f lavfi -i sine=frequency=440:sample_rate=48000 -t 4 -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest flat.mp4
exec ffmpeg -nostdin -v error -display_rotation 90 -i flat.mp4 -c copy -metadata author='Ana Lima' -metadata creation_time=2026-01-01T00:00:00Z clip.mov
cp clip.mov bad.mp4

# spec: orientation duration loudness private-metadata
ncly video convert clip.mov --dry-run --json
ncly video convert clip.mov --json
reads -case 'Keeps data that a reader needs' -private 'Ana Lima' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1
reads -case 'Keeps private data of the input' -private 'Ana Lima' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1
reads -case 'Loses data that changes the meaning' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1
reads -case 'Exists, without --force' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1
reads -case 'Is a link to the input' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1
reads -case 'Temporary file' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1

# The no-normalize path also removes private metadata, without ffmpeg.
ncly video convert clip.mov --no-normalize --force --dry-run --json
ncly video convert clip.mov --no-normalize --force --json
reads -private 'Ana Lima' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height -of default=noprint_wrappers=1

# spec: hevc-output
ncly video convert clip.mov --codec h265 --force --dry-run --json
ncly video convert clip.mov --codec h265 --force --json
reads clip.converted.mp4 hevc-reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,profile,codec_tag_string -of default=noprint_wrappers=1

-- reference --
codec_name=h264
width=96
height=160
-- hevc-reference --
codec_name=hevc
profile=Main 10
codec_tag_string=hvc1
