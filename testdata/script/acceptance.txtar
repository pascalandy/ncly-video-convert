# Made media has a nondefault display rotation and private author metadata.
# ffprobe is independent of the adapter and of its wrapped programs.
exec ffmpeg -nostdin -v error -f lavfi -i testsrc2=size=160x96:rate=30 -f lavfi -i sine=frequency=440:sample_rate=48000 -t 4 -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest flat.mp4
exec ffmpeg -nostdin -v error -display_rotation 90 -i flat.mp4 -c copy -metadata author='Ana Lima' -metadata creation_time=2026-01-01T00:00:00Z clip.mov
cp clip.mov bad.mp4

# spec: orientation private-metadata
ncly video convert clip.mov --dry-run --json
ncly video convert clip.mov --json
reads -case 'Keeps data that a reader needs' -private 'Ana Lima' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1
reads -case 'Keeps private data of the input' -private 'Ana Lima' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1
reads -case 'Loses data that changes the meaning' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1
reads -case 'Exists, without --force' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1
reads -case 'Is a link to the input' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1
reads -case 'Temporary file' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1

# Each property has its own independent reader and a bad variant that fails it.
# spec: duration
exec ffmpeg -nostdin -v error -i clip.mov -t 1 -c copy bad-duration.mp4
reads clip.converted.mp4 duration-reference bad-duration.mp4 sh duration.sh
# spec: loudness
reads clip.converted.mp4 loudness-reference clip.mov sh loudness.sh

# The no-normalize path also removes private metadata, without ffmpeg.
ncly video convert clip.mov --no-normalize --force --dry-run --json
ncly video convert clip.mov --no-normalize --force --json
reads -private 'Ana Lima' clip.converted.mp4 reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames -count_frames -of default=noprint_wrappers=1

# spec: hevc-output
ncly video convert clip.mov --codec h265 --force --dry-run --json
ncly video convert clip.mov --codec h265 --force --json
reads clip.converted.mp4 hevc-reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,profile,codec_tag_string -of default=noprint_wrappers=1

-- reference --
codec_name=h264
width=96
height=160
nb_read_frames=120
-- hevc-reference --
codec_name=hevc
profile=Main 10
codec_tag_string=hvc1
-- duration-reference --
4 seconds within 0.1 s
-- duration.sh --
#!/bin/sh
set -eu
ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$1" | awk '{ if ($1 < 3.9 || $1 > 4.1) exit 1; print "4 seconds within 0.1 s" }'
-- loudness-reference --
48000 Hz, -16 LUFS within 0.5 LU, peak at most -1 dBTP
-- loudness.sh --
#!/bin/sh
set -eu
rate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of default=noprint_wrappers=1:nokey=1 "$1")
[ "$rate" = 48000 ]
# ebur128 measures decoded samples independently of the handler's loudnorm
# measurement and its JSON decoder. True peak is a linear amplitude here.
ffprobe -v error -f lavfi -i "amovie=$1,ebur128=metadata=1:peak=true" -show_entries frame_tags=lavfi.r128.I,lavfi.r128.true_peak -of default=noprint_wrappers=1 | awk -F= '
/\.I=/ { i=$2; seen=1 }
/\.true_peak=/ { if ($2 > peak) peak=$2 }
END { if (!seen || i < -16.5 || i > -15.5 || peak <= 0 || 20*log(peak)/log(10) > -1) exit 1; print "48000 Hz, -16 LUFS within 0.5 LU, peak at most -1 dBTP" }'
