# An accepted privacy limit uses -case '<case>' -limit <id>. Name its ID in
# Accepted for every matrix row of that case, and declare the same Output:
# binding in its Limit cell. Keep -private for text that
# must stay absent, and keep the independent reader and failing bad variant.
# Check the retained metadata and a nondefault display declaration there.
# Made media has a nondefault display rotation and descriptive metadata.
# Controlled author tags demonstrate possible retention through ffprobe reads.
exec ffmpeg -nostdin -v error -f lavfi -i testsrc2=size=160x96:rate=30 -f lavfi -i sine=frequency=440:sample_rate=48000 -t 4 -c:v libx264 -pix_fmt yuv420p -c:a aac -shortest flat.mp4
exec ffmpeg -nostdin -v error -display_rotation 90 -i flat.mp4 -c copy -metadata author='Ana Lima' clip.mov
cp clip.mov bad.mp4

# spec: orientation metadata-retained
ncly video convert clip.mov --dry-run --json
ncly video convert clip.mov --json
# This bad variant keeps the correctly sized pixels and adds a wrong matrix.
exec ffmpeg -nostdin -v error -display_rotation 180 -i clip.converted.mp4 -c copy residual-rotation.mp4
exec ffmpeg -nostdin -v error -i clip.converted.mp4 -vf hflip,vflip -c:v libx264 -an upside-down.mp4
reads -case 'Loses data that changes the meaning' clip.converted.mp4 upright-reference upside-down.mp4 sh upright.sh
reads clip.converted.mp4 upright-reference residual-rotation.mp4 sh upright.sh
reads clip.converted.mp4 author-reference flat.mp4 ffprobe -v error -show_entries format_tags=artist -of default=noprint_wrappers=1:nokey=1
cp clip.converted.mp4 preserved.mp4

# The old output is deliberately different from a fresh conversion.
# spec: output-exists publication-cases
cp clip.mov exists.mov
cp flat.mp4 exists.converted.mp4
protect exists.mov exists.converted.mp4
refuses CONFIRMATION_REQUIRED ncly video convert exists.mov
reads -case 'Exists, without --force' exists.converted.mp4 flat-reference preserved.mp4 sh stream.sh

# A real output symlink points to the input before the refusal. The reader
# sees the preserved original dimensions and its unapplied display matrix.
# spec: unsafe-output
cp clip.mov alias.mov
symlink alias.converted.mp4 -> alias.mov
protect alias.mov alias.converted.mp4
refuses USAGE_INVALID ncly video convert alias.mov --force
reads -case 'Is a link to the input' alias.converted.mp4 original-reference preserved.mp4 sh stream.sh

# A predictable temporary name is already a link to the protected input.
# Exclusive random staging must ignore it, leave it unchanged and publish
# a separately decoded complete output.
cp clip.mov temporary.mov
symlink temporary.converted.mp4.tmp -> temporary.mov
protect temporary.mov temporary.converted.mp4.tmp
ncly video convert temporary.mov --dry-run --json
keeps 0 ncly video convert temporary.mov --json
reads -case 'Temporary file' temporary.converted.mp4.tmp original-reference preserved.mp4 sh stream.sh
reads temporary.converted.mp4 reference bad.mp4 sh stream.sh

# Each property has a reader and a bad variant that fails that property.
# spec: duration
exec ffmpeg -nostdin -v error -i clip.mov -t 1 -c copy bad-duration.mp4
reads clip.converted.mp4 duration-reference bad-duration.mp4 sh duration.sh
# spec: loudness
reads clip.converted.mp4 loudness-reference clip.mov sh loudness.sh

# The no-normalize control also demonstrates possible author retention.
# spec: metadata-retained
ncly video convert clip.mov --no-normalize --force --dry-run --json
ncly video convert clip.mov --no-normalize --force --json
reads clip.converted.mp4 reference bad.mp4 sh stream.sh
reads clip.converted.mp4 author-reference flat.mp4 ffprobe -v error -show_entries format_tags=artist -of default=noprint_wrappers=1:nokey=1

# Capture timestamps vary by HandBrake version. Repeated media content does not.
# spec: determinism
cp clip.converted.mp4 repeat-first.mp4
ncly video convert clip.mov --no-normalize --force --dry-run --json
ncly video convert clip.mov --no-normalize --force --json
cp stdout repeat-answer.json
reads clip.converted.mp4 repeat-reference bad-duration.mp4 sh repeat.sh repeat-first.mp4 repeat-answer.json {}

# spec: hevc-output
ncly video convert clip.mov --codec h265 --force --dry-run --json
ncly video convert clip.mov --codec h265 --force --json
reads clip.converted.mp4 hevc-reference bad.mp4 ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,profile,codec_tag_string:stream_side_data=rotation -of default=noprint_wrappers=1

-- reference --
codec_name=h264
width=96
height=160
nb_read_frames=120
-- original-reference --
codec_name=h264
width=160
height=96
nb_read_frames=120
rotation=90
-- author-reference --
Ana Lima
-- hevc-reference --
codec_name=hevc
profile=Main 10
codec_tag_string=hvc1
-- duration-reference --
4 seconds within 0.1 s
-- stream.sh --
#!/bin/sh
set -eu
ffprobe -v error -select_streams v:0 -show_entries stream=codec_name,width,height,nb_read_frames:stream_side_data=rotation -count_frames -of default=noprint_wrappers=1 "$1"
-- duration.sh --
#!/bin/sh
set -eu
ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$1" | awk '{ if ($1 < 3.9 || $1 > 4.1) exit 1; print "4 seconds within 0.1 s" }'
-- loudness-reference --
48000 Hz, -16 LUFS within 0.5 LU, peak at most -1 dBTP
-- loudness.sh --
#!/bin/sh
set -eu
rate=$(ffprobe -v error -select_streams a:0 -show_entries stream=sample_rate -of default=noprint_wrappers=1:nokey=1 "$1")
[ "$rate" = 48000 ]
# ebur128 measures decoded samples independently of the handler's loudnorm.
ffprobe -v error -f lavfi -i "amovie=$1,ebur128=metadata=1:peak=true" -show_entries frame_tags=lavfi.r128.I,lavfi.r128.true_peak -of default=noprint_wrappers=1 | awk -F= '
/\.I=/ { i=$2; seen=1 }
/\.true_peak=/ { if ($2 > peak) peak=$2 }
END { if (!seen || i < -16.5 || i > -15.5 || peak <= 0 || 20*log(peak)/log(10) > -1) exit 1; print "48000 Hz, -16 LUFS within 0.5 LU, peak at most -1 dBTP" }'
-- flat-reference --
codec_name=h264
width=160
height=96
nb_read_frames=120
-- upright-reference --
upright
-- upright.sh --
#!/bin/sh
set -eu
rot=$(ffprobe -v error -select_streams v:0 -show_entries stream_side_data=rotation -of default=noprint_wrappers=1:nokey=1 "$1")
[ -z "$rot" ]
ffprobe -v error -f lavfi -i "movie=$1,scale=96:160,format=gray[o];movie=flat.mp4,transpose=cclock,scale=96:160,format=gray[r];[o][r]ssim" -show_entries frame_tags=lavfi.ssim.All -of default=noprint_wrappers=1:nokey=1 | awk '{ s += $1; n++ } END { if (!n || s / n < 0.9) exit 1; print "upright" }'
-- repeat-reference --
same frames, duration and audio, close video
-- repeat.sh --
#!/bin/sh
set -eu
first=$1
answer=$2
second=$3
frames() { ffprobe -v error -count_frames -select_streams v:0 -show_entries stream=nb_read_frames -of default=noprint_wrappers=1:nokey=1 "$1"; }
duration() { ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$1"; }
audio() { ffprobe -v error -select_streams a:0 -show_packets -show_entries packet=data_hash -show_data_hash sha256 -of compact=p=0 "$1"; }
[ "$(frames "$first")" = "$(frames "$second")" ]
[ "$(duration "$first")" = "$(duration "$second")" ]
[ "$(audio "$first")" = "$(audio "$second")" ]
encoder=$(sed -n 's/.*"encoder":"\([^"]*\)".*/\1/p' "$answer")
case "$encoder" in vt_*|qsv_*) least=0.99 ;; x264|x265_10bit) least=0.999 ;; *) exit 1 ;; esac
ffprobe -v error -f lavfi -i "movie=$first[a];movie=$second[b];[a][b]ssim" -show_entries frame_tags=lavfi.ssim.All -of default=noprint_wrappers=1:nokey=1 | awk -v least="$least" '{ s += $1; n++ } END { if (!n || s/n < least) exit 1; print "same frames, duration and audio, close video" }'
