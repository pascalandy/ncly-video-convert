# The kit signals the real host and validates its exit, answer, and surviving files.
chmod 755 bin/HandBrakeCLI

# spec: interrupted
env QA_PHASE=scan
env QA_MARKER=started-INT-scan
survives clip.mov clip.converted.mp4
signal INT $QA_MARKER ncly video convert clip.mov --force --dry-run
! stdout .
exec sh bin/assert-invariants

# spec: terminated
env QA_MARKER=started-TERM-scan
survives clip.mov clip.converted.mp4
signal TERM $QA_MARKER ncly video convert clip.mov --force --dry-run
! stdout .
exec sh bin/assert-invariants

# spec: interrupted
env QA_PHASE=encode
env QA_MARKER=started-INT-encode
survives new.mov
signal INT $QA_MARKER ncly video convert new.mov
! stdout .
! exists new.converted.mp4
exec sh bin/assert-invariants

# spec: terminated
env QA_MARKER=started-TERM-encode
survives clip.mov clip.converted.mp4
signal TERM $QA_MARKER ncly video convert clip.mov --force
! stdout .
exec sh bin/assert-invariants

-- clip.mov --
original
-- new.mov --
original
-- clip.converted.mp4 --
previous
-- bin/HandBrakeCLI --
#!/bin/sh
set -eu
printf '%s\n' "$$" >> "$WORK/stub.pids"
output=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help) printf '   x264\n'; exit 0 ;;
    --output) output=$2; shift ;;
    --scan)
      if [ "$QA_PHASE" = scan ]; then
        : > "$WORK/$QA_MARKER"
        exec sleep 30
      fi
      echo 'JSON Title Set: {"TitleList":[{"AudioList":[],"Duration":{"Ticks":360000},"FrameRate":{"Num":25,"Den":1}}]}'
      exit 0 ;;
  esac
  shift
done
echo partial > "$output"
: > "$WORK/$QA_MARKER"
exec sleep 30
-- bin/assert-invariants --
#!/bin/sh
set -eu
for p in .ncly-video-convert-*; do
  test ! -e "$p" && test ! -L "$p" || exit 91
done
if [ -f stub.pids ]; then
  while read -r pid; do
    if kill -0 "$pid" 2>/dev/null; then
      echo "surviving stub PID $pid" >&2
      exit 92
    fi
  done < stub.pids
fi
