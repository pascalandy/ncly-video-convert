# Signals traverse the real host, extension, and runner in both phases.
# The driver returns the host's exact exit and checks files and stub PIDs.
chmod 755 bin/HandBrakeCLI
env NCLY_NO_INPUT=1
env NCLY_JSON=1
env QA_INPUT=clip.mov

# spec: interrupted
exits 130 sh bin/drive-signal INT scan
stderr '"code":"INTERRUPTED"'
! stdout .
# spec: terminated
exits 143 sh bin/drive-signal TERM scan
stderr '"code":"TERMINATED"'
! stdout .
# spec: interrupted
exits 130 sh bin/drive-signal INT encode new.mov
stderr '"code":"INTERRUPTED"'
! stdout .
# spec: terminated
exits 143 sh bin/drive-signal TERM encode
stderr '"code":"TERMINATED"'
! stdout .

-- clip.mov --
original
-- clip.mov.before --
original
-- new.mov --
original
-- new.mov.before --
original
-- clip.converted.mp4 --
previous
-- previous.mp4 --
previous
-- bin/HandBrakeCLI --
#!/bin/sh
set -eu
printf '%s\n' "$$" >> "$WORK/stub.pids"
output=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --help) printf '   x264\n'; exit 0 ;;
    --output) output=$2; shift ;;
    --scan)
      if [ "$QA_PHASE" = scan ]; then
        : > "$WORK/$QA_MARKER"
        exec sleep 30
      fi
      echo 'JSON Title Set: {"TitleList":[{"AudioList":[],"Duration":{"Ticks":360000},"FrameRate":{"Num":25,"Den":1}}]}'
      exit 0 ;;
  esac
  shift
done
echo partial > "$output"
: > "$WORK/$QA_MARKER"
exec sleep 30
-- bin/assert-invariants --
#!/bin/sh
set -eu
cmp "$QA_INPUT" "$QA_INPUT.before"
if [ "$QA_INPUT" = new.mov ]; then
  test ! -e new.converted.mp4
else
  cmp "${QA_INPUT%.*}.converted.mp4" previous.mp4
fi
for p in .ncly-video-convert-*; do
  test ! -e "$p" && test ! -L "$p" || exit 91
done
if [ -f stub.pids ]; then
  while read -r pid; do
    if kill -0 "$pid" 2>/dev/null; then
      echo "surviving stub PID $pid" >&2
      exit 92
    fi
  done < stub.pids
fi
-- bin/drive-signal --
#!/bin/sh
set -eu
signal=$1
phase=$2
export QA_INPUT="${3:-clip.mov}"
export QA_PHASE="$phase" QA_MARKER="started-$signal-$phase"
if [ "$phase" = scan ]; then
  ncly video convert "$QA_INPUT" --force --dry-run > host.stdout 2> host.stderr &
elif [ "$QA_INPUT" = new.mov ]; then
  ncly video convert "$QA_INPUT" > host.stdout 2> host.stderr &
else
  ncly video convert "$QA_INPUT" --force > host.stdout 2> host.stderr &
fi
host=$!
trap 'kill -TERM "$host" 2>/dev/null || true' EXIT
i=0
until [ -f "$QA_MARKER" ]; do
  i=$((i+1))
  if [ "$i" -ge 200 ]; then
    echo 'stub never reached requested phase' >&2
    exit 93
  fi
  sleep 0.05
done
kill -"$signal" "$host"
status=0
wait "$host" || status=$?
cat host.stdout
cat host.stderr >&2
sh bin/assert-invariants
printf '%s\n' "$status" > host.exit
trap - EXIT
exit "$status"
